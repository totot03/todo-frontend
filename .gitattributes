# 줄바꿈 정규화 — Windows(core.autocrlf=true)에서도 저장소에는 항상 LF 로 저장한다.
# Prettier 의 endOfLine:"lf" 와 짝을 이루어 "포맷터 ↔ git" 사이의 무한 diff 를 막는다.
* text=auto eol=lf

# husky 훅은 sh 스크립트 — CRLF 이면 실행되지 않는다
.husky/*    text eol=lf
*.sh        text eol=lf

*.bat       text eol=crlf
*.cmd       text eol=crlf

# 바이너리
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.woff      binary
*.woff2     binary

# 자동 생성 파일 — 리뷰 diff 에서 접어둔다
package-lock.json  linguist-generated=true -diff
