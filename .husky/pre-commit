#!/usr/bin/env sh
# ─────────────────────────────────────────────
# pre-commit (todo-frontend) — "커밋 순간" 방어선
#   스테이징된 파일만 검사한다: 빠르고, 검사 대상 == 커밋 대상.
#   프로젝트 전체를 봐야 하는 타입 체크는 pre-push 로 분리했다.
# ─────────────────────────────────────────────

# 초기 커밋 전에는 HEAD 가 없어 diff 기준이 필요하다 → 빈 트리 해시 사용
if git rev-parse --verify HEAD >/dev/null 2>&1; then
  AGAINST=HEAD
else
  AGAINST=$(git hash-object -t tree /dev/null)
fi

# 1) 시크릿 스캔 — 포맷팅보다 먼저 실행해 유출을 즉시 차단한다
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR "$AGAINST")
if [ -n "$STAGED_FILES" ]; then
  echo "$STAGED_FILES" | tr '\n' '\0' \
    | xargs -0 npx --no -- secretlint --maskSecrets --secretlintignore .gitignore \
    || {
      echo ""
      echo "❌ 커밋 중단: 스테이징된 파일에서 시크릿(키/토큰/비밀번호)이 감지되었습니다."
      echo "   값을 .env.local 로 옮기고 git restore --staged <파일> 후 다시 커밋하세요."
      exit 1
    }
fi

# 2) lint-staged — .lintstagedrc.mjs 규칙으로 eslint --fix → prettier --write
npx --no -- lint-staged
